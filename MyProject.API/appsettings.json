{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=MyProjectDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Algorithm": {
    "SolverBaseUrl": "http://localhost:5080",
    "SolverTimeoutMs": 30000,
    "SolverPollIntervalMs": 500,
    "SolverDifficultyThreshold": 70,
    "ClassificationBalanceTolerancePercent": 10
  },
  "Jwt": {
    "Key": "MyProject-Dev-Signing-Key-At-Least-32-Chars-Long!",
    "Issuer": "MyProject.API",
    "Audience": "MyProject.Client",
    "ExpirationMinutes": 480
  },
  "AllowedHosts": "*"
}